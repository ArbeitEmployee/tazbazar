# Email Configuration
# Use placeholders here. Put real credentials only in .env (git-ignored).
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM="Your Store <your-email@gmail.com>"
EMAIL_SECURE=false

# Authentication
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-domain.com

# Runtime
NODE_ENV=production
PORT=4000
MARKETPLACE_MODE=single
API_PUBLIC_URL=https://api.your-domain.com
STORE_NAME=Your Store
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=

# Database
# Never commit a real MongoDB URI. Keep it in .env only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=Cluster0
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2

# Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Caching
PUBLIC_SETTINGS_CACHE_TTL_MS=60000
RESPONSE_CACHE_TTL_MS=30000
RESPONSE_CACHE_MAX_ENTRIES=2000
IMAGE_LOOKUP_CACHE_TTL_MS=300000
IMAGE_LOOKUP_CACHE_MAX_ENTRIES=5000
